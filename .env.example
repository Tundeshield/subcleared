# ---- Browser (Vite) — Firebase web app config (Project settings → Your apps) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# ---- Server (Netlify environment variables — never prefix with VITE_) ----
# Service account JSON (raw or base64) with Firestore + Storage + Auth admin access
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Public site URL, used in email links
APP_URL=https://subcleared.netlify.app
# 32+ random characters; signs portal sessions and internal job calls
PORTAL_SESSION_SECRET=
# Email (Resend). Without it, emails are logged as failed in Settings → Delivery logs
RESEND_API_KEY=
EMAIL_FROM=SubCleared <notifications@yourdomain.com>
# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=
# Optional: override plan catalogue/limits as JSON (see src/domain/plans.ts)
PLANS_JSON=
# Optional: AI document extraction (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: external antivirus endpoint (e.g. ClamAV REST) — POST bytes, expects {"clean": true}
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
# Optional: manual trigger for the scheduler (POST /internal/jobs/run with x-cron-secret)
CRON_SECRET=
