{
  "name": "subcleared",
  "version": "1.0.0",
  "description": "SubCleared — subcontractor compliance and readiness platform",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/dev.ts",
    "dev:web": "VITE_AUTH_MODE=dev vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:dev": "VITE_AUTH_MODE=dev vite build --outDir dist-dev",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@netlify/functions": "^6.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.35.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "stripe": "^23.1.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module"
}
