rules_version = '2';
// SubCleared reads and writes Firestore exclusively from server functions
// (Firebase Admin SDK), where every request is authenticated, authorised
// against the caller's organisation membership and role, and audited.
// Client SDK access is therefore denied entirely — this removes any chance of
// cross-tenant reads, direct object references or unaudited writes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
